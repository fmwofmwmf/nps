{
    "system": {
        "name": "Rigid3D",
        "problem_name": "klann",
        "contact_stiffness": 1e8
    },
    "subspace": {
        "dim": 1,
        "shape_space_range": [
          [0.5,1.5],
          [0.5,1.5],
          [0.5,1.5]
        ],
        "domain_type": "normal"
    },
    "training": {
        "n_train_iters": 200000,
        "batch_size": 64,
        "report_every": 1000,
        "save_every": 3000,
        "weight_expand": 1.0,
        "sigma_scale": 1.0,
        "expand_type": "iso"
    },
    "optimizer": {
        "otype": "Adam",
        "learning_rate": 1e-4,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8,
        "weight_decay": 0.0,
        "fused": true,
        "lr_decay_every": 100000,
        "lr_decay_frac": 0.5
    },
    "encoding": {
        "otype": "Identity"
    },
    "network": {
        "otype": "SubspaceMLP",
        "activation": "ELU",
        "output_activation": "None",
        "n_neurons": 128,
        "n_hidden_layers": 3
    },
    "logging": {
        "output_dir": "./experiments",
        "experiment_name": "klann"
    }
}
