{
    "logging": {
        "output_dir": "./experiments",
        "experiment_name": "bar_walker"
    },
    "system": {
        "name": "Bar2D",
        "problem_name": "file",
        "mechanism_name": "objects/guy.txt",
        "joint_stiffness": 1e5,
        "ground_truth_offset": [-5, 0, 0]
    },
    "subspace": {
        "dim": 2,
        "shape_space_range": [

        ],
        "domain_type": "normal"
    },
    "collection": {
        "dt": 0.01,
        "samples": [
            {"torque":  512, "n_steps": 100},
            {"torque": -512, "n_steps": 100}
        ]
    },
    "training": {
        "n_train_iters": 200000,
        "batch_size": 32,
        "report_every": 1000,
        "save_every": 5000,
        "weight_expand": 1.0,
        "weight_landscape": 1e-3,
        "sigma_scale": 1.0,
        "expand_type": "iso"
    },
    "optimizer": {
        "otype": "Adam",
        "learning_rate": 1e-4,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8,
        "weight_decay": 0.0,
        "lr_decay_every": 2000,
        "lr_decay_frac": 0.5
    },
    "encoding": {
        "otype": "Identity"
    },
    "network": {
        "otype": "SubspaceMLP",
        "activation": "Softplus",
        "n_neurons": 128,
        "n_hidden_layers": 3
    }
}